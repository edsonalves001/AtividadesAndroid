<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBE5E5"
    tools:context=".MainActivity">

    <TextView
            android:id="@+id/txv_nome_app"
            android:layout_width="261dp"
            android:layout_height="115dp"
            android:layout_marginTop="88dp"
            android:text="Calculo da primeira lei de Ohn"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.253"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    <EditText
            android:id="@+id/edt_temp"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Digite a tensão"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.532"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txv_nome_app" android:layout_marginTop="24dp"/>

    <EditText
            android:id="@+id/edt2_temp"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Digite a Resistência"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_temp" android:layout_marginTop="52dp"
            app:layout_constraintHorizontal_bias="0.532"/>
    <EditText
            android:id="@+id/edt3_temp"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Digite a corrente"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt2_temp" android:layout_marginTop="36dp"
            app:layout_constraintHorizontal_bias="0.532"/>

    <Button
            android:id="@+id/btn_calcular"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#622C2C"
            android:text="Calcular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.532"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt3_temp" android:layout_marginTop="52dp"/>
    <TextView
        android:id="@+id/txv_resultado"
        android:layout_width="237dp"
        android:layout_height="34dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.568"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_calcular" />

</androidx.constraintlayout.widget.ConstraintLayout>